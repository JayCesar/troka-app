{
  "name": "troka",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @troka/web",
    "build": "npm run build -w @troka/web",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:status": "supabase status",
    "db:test": "supabase test db",
    "db:types": "supabase gen types typescript --local --schema public > apps/web/src/lib/database.types.ts && prettier --write apps/web/src/lib/database.types.ts"
  },
  "devDependencies": {
    "supabase": "^3.0.0"
  }
}

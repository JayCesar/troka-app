# Só a URL e a anon key públicas do projeto. NUNCA a service_role: o MCP age sempre como o usuário.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=

# Só no modo stdio (dev local / Claude Code): access token do usuário logado.
# No modo HTTP o token vem do header Authorization de cada requisição.
TROKA_ACCESS_TOKEN=

# Modo HTTP
MCP_HOST=127.0.0.1
MCP_PORT=8765

# Hosts aceitos no header Host (proteção contra DNS rebinding). Em produção: o domínio do serviço.
MCP_ALLOWED_HOSTS=127.0.0.1:*,localhost:*

# ---- Assistente (/chat) ----
# Cadeia de modelos em ordem de preferência: provedor:modelo, separados por vírgula.
# Provedores: anthropic, openrouter, ollama (local, sem chave). Sem chave = pulado.
LLM_CADEIA=anthropic:claude-opus-5-5
LLM_EFFORT=medium
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
OLLAMA_URL=http://127.0.0.1:11434/v1
# Origens do front autorizadas a chamar /chat
CHAT_CORS_ORIGINS=http://localhost:5173
# Teto de tokens por resposta nos provedores formato OpenAI (OpenRouter reserva crédito por esse valor)
LLM_MAX_TOKENS=2048

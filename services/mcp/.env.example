# Só a URL e a anon key públicas do projeto. NUNCA a service_role: o MCP age sempre como o usuário.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=

# Só no modo stdio (dev local / Claude Code): access token do usuário logado.
# No modo HTTP o token vem do header Authorization de cada requisição.
TROKA_ACCESS_TOKEN=

# Modo HTTP
MCP_HOST=127.0.0.1
MCP_PORT=8765

# Hosts aceitos no header Host (proteção contra DNS rebinding). Em produção: o domínio do serviço.
MCP_ALLOWED_HOSTS=127.0.0.1:*,localhost:*
